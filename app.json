{
  "expo": {
    "name": "Poica",
    "slug": "poica",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.gotam5.poica",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "com.gotam5.poica",
      "adaptiveIcon": {
        "backgroundColor": "#0A7552",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "カードのバーコードを読み取るためにカメラを使います。",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "アプリを開いている間だけ現在地を使い、いまいる店のカードを一番上に出します。設定でオンにしている場合だけ、近くの店を調べるためにおおまかな位置(約100m単位)を地図データ(OpenStreetMap)に送ります。",
          "isIosBackgroundLocationEnabled": false,
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "motionUsagePermission": false
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "バーコードが読めないカードを写真で保存するためにカメラを使います。",
          "photosPermission": "カードの写真を選ぶために写真ライブラリを使います。",
          "microphonePermission": false
        }
      ],
      "expo-iap"
    ],
    "extra": {
      "eas": {
        "projectId": "2d0c0628-149d-4672-9e9b-c71544c52fe0"
      }
    }
  }
}
